<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
</head>
<body style="margin: 0; padding: 0; background-color: #f0ebf9; font-family: sans-serif;">
    <table role="presentation" style="width: 100%; border-collapse: collapse;">
        <tr>
            <td align="center" style="padding: 40px 0;">
                <table role="presentation" style="max-width: 480px; background-color: #ffffff; border-radius: 12px; padding: 40px; text-align: center; border: 1px solid #d6c9ed;">
                    <tr>
                        <td>
                            <h2 style="color: #252030; margin-bottom: 16px;">Welcome to YoBlogger!</h2>
                            
                            <a href="<%= actionUrl %>" style="background-color: #7c4dff; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 600; display: inline-block;">
                                <%= buttonText %>
                            </a>
                            <p style="color: #8e83a0; font-size: 13px; margin-top: 24px;">
                                Expires in <%= expiresIn %>.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>