<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login OTP - YoBlogger</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f0ebf9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    <table role="presentation" style="width: 100%; border-collapse: collapse;">
        <tr>
            <td align="center" style="padding: 40px 0;">
                <table role="presentation" style="width: 100%; max-width: 480px; background-color: #ffffff; border-radius: 12px; border: 1px solid #d6c9ed; box-shadow: 0 4px 16px rgba(124, 77, 255, 0.12); padding: 40px; text-align: center;">
                    <tr>
                        <td>
                            <!-- Icon / Heading -->
                            <h2 style="color: #252030; font-size: 24px; font-weight: 700; margin-top: 0; margin-bottom: 12px;">Login Verification</h2>
                            
                            <p style="color: #5c536b; font-size: 15px; line-height: 1.5; margin-bottom: 24px;">
                                Hi <%= typeof name !== 'undefined' ? name : 'User' %>,<br>
                                Use the One-Time Password (OTP) below to securely log in to your YoBlogger account.
                            </p>

                            <!-- OTP Box Display -->
                            <div style="background-color: #f0ebf9; border: 1px dashed #7c4dff; border-radius: 8px; padding: 16px; margin-bottom: 24px;">
                                <span style="font-size: 32px; font-weight: 800; letter-spacing: 6px; color: #7c4dff;">
                                    <%= otp %>
                                </span>
                            </div>

                            <p style="color: #8e83a0; font-size: 13px; line-height: 1.4; margin-bottom: 0;">
                                This OTP will expire in <strong><%= typeof expiresIn !== 'undefined' ? expiresIn : '5 minutes' %></strong>. If you didn't request this, please ignore this email.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>